    "DirectoryPickerDialog": "src/frontend/components/DirectoryPickerDialog.tsx",
    "FilterInput": "src/frontend/components/FilterInput.tsx",
    "HelpButton": "src/frontend/components/HelpDialog.tsx",
    "InitialPathAutocomplete": "src/frontend/components/InitialPathAutocomplete.tsx",
    "ProjectDialog": "src/frontend/components/ProjectDialog.tsx",
    "RenameDialog": "src/frontend/components/RenameDialog.tsx",
    "SettingsButton": "src/frontend/components/SettingsDialog.tsx",
    "StatusDot": "src/frontend/components/StatusDot.tsx",
    "SymbolPopover": "src/frontend/components/SymbolPopover.tsx",
    "TabSwitcher": "src/frontend/components/TabSwitcher.tsx",
    "TerminalPreview": "src/frontend/components/TerminalPreview.tsx",
    "TerminalSearchBar": "src/frontend/components/TerminalSearchBar.tsx"
