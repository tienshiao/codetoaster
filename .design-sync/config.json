    "InitialPathAutocomplete": {
      "cardMode": "column"
    },
    "Input": {
      "cardMode": "column"
    },
    "Textarea": {
      "cardMode": "column"
    },
    "Collapsible": {
      "cardMode": "column"
    },
    "Separator": {
      "cardMode": "column"
    },
    "Command": {
      "cardMode": "column"
    },
    "TerminalSearchBar": {
      "cardMode": "column"
    }
