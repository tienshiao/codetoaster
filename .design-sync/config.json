    },
    "DirectoryPickerDialog": {
      "cardMode": "single",
      "primaryStory": "BrowsingToAProject"
    },
    "HelpButton": {
      "cardMode": "single",
      "primaryStory": "ShortcutReference"
    },
    "ProjectDialog": {
      "cardMode": "single",
