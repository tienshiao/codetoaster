    "AlertDialog": {
      "cardMode": "single",
      "primaryStory": "CloseSession"
    },
    "Sheet": {
      "cardMode": "single",
      "primaryStory": "SessionDetails"
    },
    "DropdownMenu": {
      "cardMode": "single",
      "primaryStory": "SessionActions"
    },
    "Popover": {
      "cardMode": "single",
      "primaryStory": "SymbolLookup"
    },
    "Tooltip": {
      "cardMode": "single",
