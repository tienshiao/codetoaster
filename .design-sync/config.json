    "Dialog": "src/frontend/components/ui/dialog.tsx",
    "DropdownMenu": "src/frontend/components/ui/dropdown-menu.tsx",
    "Input": "src/frontend/components/ui/input.tsx",
    "Popover": "src/frontend/components/ui/popover.tsx",
    "Select": "src/frontend/components/ui/select.tsx",
    "Separator": "src/frontend/components/ui/separator.tsx",
    "Sheet": "src/frontend/components/ui/sheet.tsx",
    "Sidebar": "src/frontend/components/ui/sidebar.tsx",
    "Skeleton": "src/frontend/components/ui/skeleton.tsx",
    "Tabs": "src/frontend/components/ui/tabs.tsx",
    "Textarea": "src/frontend/components/ui/textarea.tsx",
